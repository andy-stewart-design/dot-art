---
import Layout from "@/layouts/Layout.astro";
import AndyLogo from "@/components/svg/andy-logo.svg";
import Linkedin from "@/components/svg/linkedin.svg";
import Bluesky from "@/components/svg/bluesky.svg";
import Codepen from "@/components/svg/codepen.svg";
import Github from "@/components/svg/github.svg";
---

<Layout>
  <section>
    <div class="content">
      <header>
        <a class="logo" href="/">
          <AndyLogo class="logomark" width="36" height="36" />
          <h2>Andy Stewart</h2>
        </a>
        <div class="links">
          <a
            href="https://github.com/andy-stewart-design"
            target="_blank"
            aria-label="Github"
          >
            <Github width="20" height="20" />
          </a>
          <a
            href="https://codepen.io/andystewartdesign"
            target="_blank"
            aria-label="Codepen"
          >
            <Codepen width="20" height="20" />
          </a>
          <a
            href="https://bsky.app/profile/andystew.art"
            target="_blank"
            aria-label="Bluesky"
          >
            <Bluesky width="20" height="20" />
          </a>
          <a
            href="https://linkedin.com/in/andystewartdesign/"
            target="_blank"
            aria-label="LinkedIn"
          >
            <Linkedin width="20" height="20" />
          </a>
        </div>
      </header>
      <div class="content-area">
        <video
          src="https://res.cloudinary.com/andystewartdesign/video/upload/v1686329639/work/teague/Teague-Mobile.mp4"
          controls></video>
        <div class="buttons">
          <a href="https://www.andystewart.design/" target="_blank"
            >Work Archive</a
          >
          <a href="/">Homepage</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  section {
    display: grid;
    height: 100svh;

    & > * {
      grid-area: 1/1;
    }
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem 0.75rem 1.25rem;
    background: rgb(100 100 100 / 0.05);
    border-radius: 0.5rem;
    outline: 1px solid rgb(255 255 255 / 0.15);
    backdrop-filter: blur(4px);
    width: 100%;
    max-width: 480px;

    .logo {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      color: inherit;
      text-decoration: none;

      &:visited {
        color: inherit;
      }

      .logomark {
        color: oklch(0.7 0.24 25.4);
      }

      h2 {
        line-height: 0.96;
        margin: 0;
        text-align: left;
        font-size: 1rem;
        font-weight: 600;
        user-select: none;
        width: 8ch;

        @media (width > 480px) {
          font-size: 1.125rem;
          width: auto;
        }
      }
    }

    .links {
      display: flex;
      align-items: center;
    }

    a:not(.logo) {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.375rem;
      height: 2.75rem;
      text-decoration: none;
      color: oklch(0.7 0.24 25.4);

      &:visited {
        color: oklch(0.7 0.24 25.4);
      }
    }

    svg {
      vertical-align: bottom;
    }
  }

  .content {
    position: relative;
    padding: 1.5rem;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-shadow: 0px 0px 40px rgb(0 0 0 / 1);

    @media (width > 560px) {
      padding: 2rem;
      padding-bottom: 5rem;
    }

    @media (width > 640px) {
      padding-bottom: 3rem;
    }

    .content-area {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1rem;
      align-items: center;

      .buttons {
        display: flex;
        gap: 0.5rem;
      }

      video {
        width: 100%;
        max-width: 960px;
        border-radius: 0.25rem;
      }

      a {
        text-decoration: none;
        color: inherit;
        font-weight: 500;
        min-inline-size: 16ch;
        padding-block: 0.75rem calc(0.75rem + 1px);
        padding-inline: 1.5rem;
        border: 1px solid oklch(0.7 0.24 25.4);
        border-radius: 100vmax;
        user-select: none;
      }
    }
  }
</style>
